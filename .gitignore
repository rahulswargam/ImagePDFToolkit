# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# Virtual environment
venv/
.venv/

# PyInstaller working directory and compiled output (regenerated by
# `pyinstaller` from ImagePDFToolkit.spec + app.py — not source, and the
# compiled exe/installer are 75-100MB+ each, over what git should carry)
build/
dist/

# Downloaded third-party installer dependency (not our code — fetched at
# build time from https://aka.ms/vs/17/release/vc_redist.x64.exe, see README)
installer/downloads/

# Claude Code / AI assistant local files
.claude/

# Editors / IDEs
.vscode/
.idea/

# OS junk
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log

# Code-signing certificates — must NEVER be committed. See SIGNING.md.
*.pfx
*.p12
*.cer
*.crt
*.pem
*.key
